# Copy this file to .env.local for local development (never commit .env.local).
# In Vercel, paste the same names/values in Project → Settings → Environment Variables.
# docs/SETUP.md explains where to find each value.

# --- Meta WhatsApp Cloud API -------------------------------------------------
# WhatsApp → API Setup → "Access token" (temporary, 24 h) — later a permanent System User token
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup → "Phone number ID" (a number, NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → "App secret" → Show
WHATSAPP_APP_SECRET=
# Any long random text you invent; paste the same text in WhatsApp → Configuration → Webhook → Verify token
WHATSAPP_VERIFY_TOKEN=
# Graph API version (leave as is unless Meta deprecates it)
WHATSAPP_API_VERSION=v23.0
# true = print replies in the terminal instead of sending them (local testing). Leave empty/false in Vercel.
WHATSAPP_DRY_RUN=

# --- Supabase ----------------------------------------------------------------
# Project Settings → Data API → Project URL  (https://xxxx.supabase.co)
SUPABASE_URL=
# Project Settings → API Keys → secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (Anthropic) ------------------------------------------------------
# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=
# Fast model for chat, stronger model for food photos (defaults shown)
CLAUDE_CHAT_MODEL=claude-haiku-5-5
CLAUDE_VISION_MODEL=claude-sonnet-5-5
# low | medium | high — how hard the photo model thinks (more = better estimates, more cost)
CLAUDE_VISION_EFFORT=medium

# --- Cost controls (optional; defaults shown) --------------------------------
# Max messages / photos a user can send in 24 h. Past it, one friendly notice, then silence.
DAILY_MESSAGE_LIMIT=60
DAILY_PHOTO_LIMIT=5
# Wait (ms) after a text before replying, so a burst of messages gets one answer
REPLY_DEBOUNCE_MS=3000

# --- Stripe (payments) -------------------------------------------------------
# Payments are OFF until all four are set: everyone gets full access for free.
# Developers → API keys → Secret key (sk_test_... while testing)
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Product catalog → your product → price IDs (price_...)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Free demo before asking for a card
DEMO_PHOTOS=1
DEMO_QUESTIONS=3
# Only if you use your own domain (default: the Vercel production domain)
APP_URL=

# --- Vercel Cron (milestone 4 — optional for now) ----------------------------
CRON_SECRET=

# --- Public website (built into the pages; Redeploy after changing) ----------
# WhatsApp number for the "Empezar" buttons: country code + number, digits only (e.g. 5215512345678).
# Leave empty until you have the real number: buttons show "Muy pronto".
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Legal data shown in /privacidad and /terminos (while empty, they show [pendiente] and a draft notice)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_ADDRESS=
